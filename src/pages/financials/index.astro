---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { derivedFinancials, financialOverview } from '../../data/financialOverview';

const { reported, units, watchItems, sourceDocuments, asOf, reviewedOn } = financialOverview;

const currency = (value: number, digits = 2) =>
	new Intl.NumberFormat('en-US', {
		style: 'currency',
		currency: 'USD',
		minimumFractionDigits: digits,
		maximumFractionDigits: digits,
	}).format(value);

const percent = (value: number, digits = 1) =>
	new Intl.NumberFormat('en-US', {
		style: 'percent',
		minimumFractionDigits: digits,
		maximumFractionDigits: digits,
	}).format(value);

const priorityClass = (priority: string) => {
	if (priority === 'High') return 'bg-rose-100 text-rose-700 border-rose-200';
	if (priority === 'Medium') return 'bg-amber-100 text-amber-700 border-amber-200';
	return 'bg-slate-100 text-slate-700 border-slate-200';
};

const projectionScenarios = [
	{
		name: 'Q1 pace repeats',
		assumption: 'Each remaining quarter repeats the Q1 average',
		revenue: derivedFinancials.annualRevenueAtQ1Pace,
		expenses: derivedFinancials.annualExpensesAtQ1Pace,
	},
	{
		name: 'Budget for April–December',
		assumption: 'Keep Q1 actuals; both revenue and expense return to monthly budget',
		revenue: derivedFinancials.budgetRemainderRevenue,
		expenses: derivedFinancials.budgetRemainderExpenses,
	},
	{
		name: '5% remaining revenue stress',
		assumption: 'Keep Q1 actuals; April–December revenue is 5% below budget and expense is on budget',
		revenue: derivedFinancials.budgetRemainderRevenueStress,
		expenses: derivedFinancials.budgetRemainderExpenses,
	},
	{
		name: 'March pace continues',
		assumption: 'April–December repeat March revenue and expense',
		revenue: derivedFinancials.marchPaceRevenue,
		expenses: derivedFinancials.marchPaceExpenses,
	},
].map(scenario => ({ ...scenario, result: scenario.revenue - scenario.expenses }));
---

<BaseLayout
	title="Financial Position Review"
	description={`Source-verified review of China Basin HOA financial information through ${asOf}.`}
>
	<header class="mb-10 max-w-4xl">
		<div class="flex flex-wrap items-center gap-3 mb-4">
			<span class="inline-flex items-center rounded-full bg-slate-900 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">Reviewed {reviewedOn}</span>
			<span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-700">Approved statements through {asOf}</span>
			<span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-800">Independent review · not an audit</span>
		</div>
		<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-950 mb-4">Financial position review</h1>
		<p class="text-lg text-slate-600 leading-relaxed">
			A source-checked accounting, data, and community-association review of the June 2025–March 2026 statements, the budget packets, and the reserve materials supplied for this project.
		</p>
	</header>

	<div class="space-y-12">
		<section class="rounded-2xl border border-amber-300 bg-amber-50 p-5 md:flex md:items-start md:justify-between md:gap-8" aria-labelledby="reporting-lag">
			<div class="max-w-3xl">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-700 mb-1">Reporting lag</p>
				<h2 id="reporting-lag" class="text-lg font-bold text-amber-950">It is July, but March is still the latest approved statement</h2>
				<p class="text-sm text-amber-900/80 leading-relaxed mt-2">April, May, and June actual results remain unreported, and July is still in progress. The projections below are comparison models—not reported results—and should be replaced when the missing monthly packages are approved.</p>
			</div>
			<div class="mt-4 md:mt-0 md:text-right flex-shrink-0">
				<p class="text-3xl font-extrabold text-amber-900">3 months</p>
				<p class="text-xs font-semibold uppercase tracking-wider text-amber-700">of closed activity pending</p>
			</div>
		</section>

		<section class="rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-blue-50 p-6 md:p-8 shadow-sm">
			<div class="grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-3">Professional assessment</p>
					<h2 class="text-2xl md:text-3xl font-extrabold text-slate-950 mb-4">Mixed condition: positive reported earnings, but thin operating cash and material control follow-ups</h2>
					<p class="text-slate-700 leading-relaxed mb-4">
						Q1 closed with a {currency(reported.q1Surplus)} surplus because the {currency(derivedFinancials.q1ExpenseVariance)} favorable expense variance exceeded the {currency(Math.abs(derivedFinancials.q1RevenueVariance))} revenue shortfall. That is a real positive result, but March alone lost {currency(Math.abs(reported.monthlyResultsQ1[2].result))}, and operating equity declined during Q1 after a {currency(reported.currentYearAdjustment)} prior-period adjustment.
					</p>
					<p class="text-sm text-slate-600 leading-relaxed">
						The strongest immediate concern is liquidity: after recognizing the amount owed by operating to reserves, only {currency(reported.unrestrictedOperatingCash)} remains as unrestricted operating cash—about {derivedFinancials.operatingCashMonths.toFixed(1)} months of the Q1 nonreserve expense pace.
					</p>
				</div>

				<div class="grid sm:grid-cols-2 gap-3" aria-label="Financial condition by area">
					<div class="rounded-2xl border border-amber-200 bg-white p-4">
						<span class="text-xs font-bold uppercase tracking-wider text-amber-700">Operations</span>
						<p class="text-lg font-extrabold text-slate-950 mt-1">Mixed</p>
						<p class="text-xs text-slate-500 mt-1">Positive Q1; March deficit and revenue below budget.</p>
					</div>
					<div class="rounded-2xl border border-rose-200 bg-white p-4">
						<span class="text-xs font-bold uppercase tracking-wider text-rose-700">Liquidity</span>
						<p class="text-lg font-extrabold text-slate-950 mt-1">Thin</p>
						<p class="text-xs text-slate-500 mt-1">Only {derivedFinancials.operatingCashMonths.toFixed(1)} months of nonreserve expense pace.</p>
					</div>
					<div class="rounded-2xl border border-amber-200 bg-white p-4">
						<span class="text-xs font-bold uppercase tracking-wider text-amber-700">Reserves</span>
						<p class="text-lg font-extrabold text-slate-950 mt-1">Not rateable</p>
						<p class="text-xs text-slate-500 mt-1">The current study and funded percentage were not supplied.</p>
					</div>
					<div class="rounded-2xl border border-rose-200 bg-white p-4">
						<span class="text-xs font-bold uppercase tracking-wider text-rose-700">Reporting controls</span>
						<p class="text-lg font-extrabold text-slate-950 mt-1">Needs correction</p>
						<p class="text-xs text-slate-500 mt-1">Budget exhibits, suspense, and stale checks require resolution.</p>
					</div>
					</div>
				</div>

				<div class="mt-8 border-t border-slate-200 pt-8" aria-labelledby="board-transition-brief">
					<div class="mb-5 max-w-4xl">
						<p class="text-xs font-bold uppercase tracking-[0.18em] text-indigo-700 mb-2">Incoming owner-seated board</p>
						<h3 id="board-transition-brief" class="text-xl md:text-2xl font-extrabold text-slate-950">Key takeaways and post-election transition priorities</h3>
						<p class="text-sm text-slate-600 leading-relaxed mt-3">With developer control ending after the election, the first owner-seated board should treat its initial 60–90 days as a formal financial, records, and operational turnover—not merely the next routine board cycle.</p>
					</div>

					<div class="grid lg:grid-cols-2 gap-5">
						<div class="rounded-2xl border border-indigo-200 bg-indigo-50 p-5 md:p-6">
							<h4 class="font-extrabold text-indigo-950 mb-4">Key takeaways for incoming directors</h4>
							<ul class="space-y-3 text-sm text-indigo-950/80">
								<li class="flex gap-3"><span class="font-black text-indigo-600">01</span><span><strong class="text-indigo-950">Reported income is not available cash.</strong> The Q1 surplus is positive, but unrestricted operating cash is only {currency(reported.unrestrictedOperatingCash)} after the reserve obligation.</span></li>
								<li class="flex gap-3"><span class="font-black text-indigo-600">02</span><span><strong class="text-indigo-950">Most reserves are not in the reserve bank.</strong> {currency(reported.reserveDueFromOperating)}—{percent(derivedFinancials.reserveInterfundShare)} of the reserve fund—remains an interfund receivable.</span></li>
								<li class="flex gap-3"><span class="font-black text-indigo-600">03</span><span><strong class="text-indigo-950">The board will inherit a reporting backlog.</strong> April through June statements are still pending while operating costs and occupancy continue to change.</span></li>
								<li class="flex gap-3"><span class="font-black text-indigo-600">04</span><span><strong class="text-indigo-950">The governing financial record set needs repair.</strong> The supplied budget exhibits conflict with the statements, and the referenced current reserve study was not provided.</span></li>
								<li class="flex gap-3"><span class="font-black text-indigo-600">05</span><span><strong class="text-indigo-950">Developer closeout evidence must be preserved.</strong> Billing adjustments, warranties, open construction items, vendor claims, and responsibility for early-life repairs should be resolved before institutional knowledge is lost.</span></li>
							</ul>
						</div>

						<div class="rounded-2xl border border-blue-200 bg-white p-5 md:p-6 shadow-sm">
							<h4 class="font-extrabold text-slate-950 mb-4">Proposed action items</h4>
							<ol class="space-y-3 text-sm text-slate-600">
								<li class="rounded-xl border border-slate-200 p-3"><strong class="text-blue-800">First meeting · Secure control.</strong> Confirm officers, bank signers, approval limits, and direct board access to every operating, reserve, payment, accounting, insurance, and owner-record system. Access should not depend solely on management or former developer representatives.</li>
								<li class="rounded-xl border border-slate-200 p-3"><strong class="text-blue-800">First meeting · Accept a documented turnover inventory.</strong> Require bank reconciliations, general ledgers, receivable and payable aging, open checks, tax and CPA files, contracts, insurance, warranties, claims, reserve records, minutes, and a list of unresolved developer obligations with accountable owners and due dates.</li>
								<li class="rounded-xl border border-slate-200 p-3"><strong class="text-blue-800">Within 30 days · Establish the true cash position.</strong> Resolve the reserve interfund balance, suspense debit, stale insurance check, and developer-billing adjustment; adopt a reserve-repayment schedule and a minimum unrestricted operating-cash floor.</li>
								<li class="rounded-xl border border-slate-200 p-3"><strong class="text-blue-800">Within 30 days · Restore timely reporting.</strong> Complete April–June packages and begin a recurring monthly review calendar with written explanations for material variances and unreconciled items.</li>
								<li class="rounded-xl border border-slate-200 p-3"><strong class="text-blue-800">Within 60 days · Correct the financial plan.</strong> Identify the adopted 12-month 2026 budget, correct the exhibits, obtain the stated 2024/2025 reserve work or commission a current study, and formally review the reserve funding plan.</li>
								<li class="rounded-xl border border-slate-200 p-3"><strong class="text-blue-800">Within 90 days · Independent closeout review.</strong> Ask the Association's CPA and counsel to review year-end adjustments, tax and statutory reporting, turnover completeness, contracts, warranty recovery, and any continuing developer obligations.</li>
							</ol>
						</div>
					</div>
				</div>
			</section>

		<section aria-labelledby="reported-snapshot">
			<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 border-b border-slate-200 pb-3 mb-6">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">March statement snapshot</p>
					<h2 id="reported-snapshot" class="text-2xl font-bold text-slate-950">The balances, correctly classified</h2>
				</div>
				<p class="text-xs text-slate-500 max-w-md md:text-right">Re-footed to the March balance sheet and income statement.</p>
			</div>

			<div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
				<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-slate-500">Q1 reported surplus</p>
					<p class="text-3xl font-extrabold text-emerald-700 mt-2">{currency(reported.q1Surplus)}</p>
					<p class="text-xs text-slate-500 mt-3 leading-relaxed">A {percent(derivedFinancials.q1OperatingMargin)} margin before resolution of the suspense item.</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-slate-500">Total assets</p>
					<p class="text-3xl font-extrabold text-blue-700 mt-2">{currency(reported.totalAssets)}</p>
					<p class="text-xs text-slate-500 mt-3 leading-relaxed">Includes restricted reserves and {currency(reported.prepaidExpenses)} of prepaids; it is not freely spendable cash.</p>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-slate-500">Total reserve fund</p>
					<p class="text-3xl font-extrabold text-blue-700 mt-2">{currency(reported.reserveFundBalance)}</p>
					<p class="text-xs text-slate-500 mt-3 leading-relaxed">The prior {currency(reported.reserveDueFromOperating)} figure was not the total reserve balance; it is the interfund receivable.</p>
				</div>
				<div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-rose-700">Unrestricted operating cash</p>
					<p class="text-3xl font-extrabold text-rose-800 mt-2">{currency(reported.unrestrictedOperatingCash)}</p>
					<p class="text-xs text-rose-900/70 mt-3 leading-relaxed">Operating bank balance after the amount due to reserves is recognized.</p>
				</div>
			</div>
		</section>

		<section aria-labelledby="operating-performance">
			<div class="border-b border-slate-200 pb-3 mb-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">Operating performance</p>
				<h2 id="operating-performance" class="text-2xl font-bold text-slate-950">2025 was an appropriate partial startup year; 2026 is the first full 12-month model</h2>
			</div>

			<div class="grid lg:grid-cols-[1.25fr_0.75fr] gap-6">
				<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-x-auto">
					<table class="w-full min-w-[680px] text-sm">
						<thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
							<tr><th class="px-5 py-4 font-bold">Period</th><th class="px-5 py-4 font-bold text-right">Revenue</th><th class="px-5 py-4 font-bold text-right">Expenses</th><th class="px-5 py-4 font-bold text-right">Net</th></tr>
						</thead>
						<tbody class="divide-y divide-slate-100 text-slate-700">
							<tr>
								<td class="px-5 py-4"><p class="font-bold text-slate-950">2025 startup actual</p><p class="text-xs text-slate-500 mt-1">The Association became operational around May; the statements and budget use seven operating months from June through December.</p></td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(reported.revenue2025)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(reported.expenses2025)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap font-extrabold text-emerald-700">+{currency(reported.netIncome2025)}</td>
							</tr>
							<tr>
								<td class="px-5 py-4"><p class="font-bold text-slate-950">Q1 2026 actual</p><p class="text-xs text-slate-500 mt-1">January–March.</p></td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(reported.q1Revenue)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(reported.q1Expenses)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap font-extrabold text-emerald-700">+{currency(reported.q1Surplus)}</td>
							</tr>
							<tr class="bg-slate-50">
								<td class="px-5 py-4"><p class="font-bold text-slate-950">Q1 2026 budget</p><p class="text-xs text-slate-500 mt-1">Break-even budget used by the monthly statements.</p></td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(reported.q1BudgetRevenue)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(reported.q1BudgetExpenses)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap font-extrabold">{currency(0)}</td>
							</tr>
						</tbody>
					</table>
					<div class="p-5 border-t border-slate-200 bg-blue-50 text-xs text-blue-950/75 leading-relaxed">
						<strong>Interpretation:</strong> A seven-month model is appropriate for 2025 because the Association began operations late in the year. The {currency(reported.netIncome2025)} result should be evaluated as a valid partial-year startup result—not annualized or compared directly with a full 12-month year. The 2026 analysis instead uses the full-year budget and compares Q1 with that 12-month operating model.
					</div>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-slate-950 text-white p-6 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-300 mb-2">Q1 monthly result</p>
					<div class="space-y-3">
						{reported.monthlyResultsQ1.map(month => (
							<div class="flex items-center justify-between gap-4 rounded-xl border border-slate-700 bg-slate-900 px-4 py-3">
								<span class="text-sm text-slate-300">{month.month}</span>
								<span class={`font-extrabold ${month.result >= 0 ? 'text-emerald-300' : 'text-rose-300'}`}>{month.result >= 0 ? '+' : ''}{currency(month.result)}</span>
							</div>
						))}
					</div>
					<p class="text-xs text-slate-400 mt-5 leading-relaxed">March's loss coincided with higher common-area and utility costs. One month is not a trend, but it makes a straight-line Q1 forecast optimistic unless later months reverse it.</p>
				</div>
			</div>

			<div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-950 leading-relaxed">
				<strong>Equity bridge:</strong> Q1 net income was positive, yet operating equity fell from {currency(derivedFinancials.operatingEquityAt2025YearEnd)} at December 31 to {currency(derivedFinancials.operatingEquityAtQ1End)} at March 31. The reason is a {currency(reported.currentYearAdjustment)} charge to equity, principally a {currency(16_357.24)} “2025 Developer Billing Adjustment,” plus prior-period reclasses. The displayed 2025 net-income line should therefore not be treated as fully settled without the year-end review or audit.
			</div>
		</section>

		<section aria-labelledby="cash-reconciliation">
			<div class="border-b border-slate-200 pb-3 mb-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">Liquidity and fund accounting</p>
				<h2 id="cash-reconciliation" class="text-2xl font-bold text-slate-950">The reserve fund is larger than previously shown—but most of it was still owed by operating</h2>
			</div>

			<div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6">
				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-slate-500">Operating bank reconciliation</p>
					<dl class="mt-4 space-y-3 text-sm">
						<div class="flex justify-between gap-4 border-b border-slate-100 pb-3"><dt class="text-slate-600">Operating bank ledger</dt><dd class="font-bold text-slate-950">{currency(reported.operatingBankCash)}</dd></div>
						<div class="flex justify-between gap-4 border-b border-slate-100 pb-3"><dt class="text-slate-600">Less: due to reserve funds</dt><dd class="font-bold text-rose-700">({currency(reported.reserveDueFromOperating)})</dd></div>
						<div class="flex justify-between gap-4"><dt class="font-bold text-slate-950">Unrestricted operating cash</dt><dd class="font-extrabold text-rose-700">{currency(reported.unrestrictedOperatingCash)}</dd></div>
					</dl>
					<p class="text-xs text-slate-500 mt-5 leading-relaxed">This is only about {derivedFinancials.operatingCashMonths.toFixed(1)} months of average Q1 expense excluding reserve funding. Adding reported receivables produces {currency(derivedFinancials.liquidOperatingAssets)} of liquid operating assets before collectability adjustments.</p>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<div class="grid sm:grid-cols-3 gap-4">
						<div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
							<p class="text-xs font-bold uppercase tracking-wider text-emerald-700">In reserve bank</p>
							<p class="text-2xl font-extrabold text-emerald-800 mt-2">{currency(reported.reserveBankCash)}</p>
							<p class="text-xs text-emerald-900/70 mt-1">{percent(derivedFinancials.reserveBankedShare)} of total reserves</p>
						</div>
						<div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
							<p class="text-xs font-bold uppercase tracking-wider text-rose-700">Due from operating</p>
							<p class="text-2xl font-extrabold text-rose-800 mt-2">{currency(reported.reserveDueFromOperating)}</p>
							<p class="text-xs text-rose-900/70 mt-1">{percent(derivedFinancials.reserveInterfundShare)} of total reserves</p>
						</div>
						<div class="rounded-xl border border-blue-200 bg-blue-50 p-4">
							<p class="text-xs font-bold uppercase tracking-wider text-blue-700">Total reserve fund</p>
							<p class="text-2xl font-extrabold text-blue-800 mt-2">{currency(reported.reserveFundBalance)}</p>
							<p class="text-xs text-blue-900/70 mt-1">Accounting balance, not adequacy</p>
						</div>
					</div>
					<p class="text-xs text-slate-500 mt-5 leading-relaxed">The interfund schedule traces {currency(106_829.60)} to the October 2025 prior-management balance and {currency(42_732)} to unfunded November–December allocations, less a {currency(21_365.92)} February repayment. January–March current contributions did reach the reserve bank; the older balance remains outstanding.</p>
				</div>
			</div>

			<div class="mt-5 rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950 leading-relaxed">
				<strong>Monthly board review:</strong> California Civil Code <a class="font-bold underline decoration-blue-300 underline-offset-2" href="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=5500." target="_blank" rel="noreferrer">§ 5500</a> calls for monthly review of operating and reserve reconciliations, bank statements, budget-to-actual results, income and expenses, the check register, general ledger, and delinquency reports. The reserve receivable, suspense debit, and long-outstanding insurance check should each appear in that review until cleared.
			</div>
		</section>

		<section aria-labelledby="run-rate-model">
			<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 border-b border-slate-200 pb-3 mb-6">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">Projection model</p>
					<h2 id="run-rate-model" class="text-2xl font-bold text-slate-950">A range is more credible than one annualized number</h2>
				</div>
				<p class="text-xs text-slate-500 max-w-md md:text-right">Models based on approved January–March actuals. They are not the budget and are not predictions.</p>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-x-auto">
				<table class="w-full min-w-[760px] text-sm">
					<thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
						<tr><th class="px-5 py-4 font-bold">Full-year scenario</th><th class="px-5 py-4 font-bold text-right">Revenue</th><th class="px-5 py-4 font-bold text-right">Expenses</th><th class="px-5 py-4 font-bold text-right">Result</th></tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-slate-700">
						{projectionScenarios.map(scenario => (
							<tr class="align-top">
								<td class="px-5 py-4"><p class="font-bold text-slate-950">{scenario.name}</p><p class="text-xs text-slate-500 mt-1">{scenario.assumption}</p></td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(scenario.revenue)}</td>
								<td class="px-5 py-4 text-right whitespace-nowrap">{currency(scenario.expenses)}</td>
								<td class={`px-5 py-4 text-right whitespace-nowrap font-extrabold ${scenario.result >= 0 ? 'text-emerald-700' : 'text-rose-700'}`}>{scenario.result >= 0 ? '+' : ''}{currency(scenario.result)}</td>
							</tr>
						))}
					</tbody>
				</table>
				<div class="p-5 border-t border-slate-200 bg-slate-50 text-xs text-slate-600 leading-relaxed"><strong>Reading the range:</strong> The Q1 run-rate case is the optimistic end because it assumes favorable expense timing persists. Returning to budget for the remaining nine months preserves the Q1 surplus. A modest revenue miss or a repeat of March's relationship between revenue and expense produces a deficit.</div>
			</div>

			<div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-5 text-xs text-amber-900/80 leading-relaxed">
				<strong>Projection limits:</strong> The model does not estimate seasonality, catch-up invoices, reserve expenditures, contract changes, utility growth, insurance renewal, delinquency, or warranty recovery. Closings rose from {units.closedAtStatementDate} at March 31 to {units.closedAtReviewDate} at July 20, so occupancy-sensitive utility and reimbursement behavior may already differ from Q1.
			</div>
		</section>

		<section aria-labelledby="document-control">
			<div class="border-b border-slate-200 pb-3 mb-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-rose-700 mb-1">Budget and reserve document control</p>
				<h2 id="document-control" class="text-2xl font-bold text-slate-950">The supplied packets do not support every statement they make</h2>
			</div>

			<div class="grid md:grid-cols-2 gap-5">
				<div class="rounded-2xl border border-rose-200 bg-rose-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-rose-700">2026 operating budget exhibit</p>
					<h3 class="text-lg font-bold text-rose-950 mt-2">A valid 2025 partial-year exhibit was reused for full-year 2026</h3>
					<p class="text-sm text-rose-900/80 mt-3 leading-relaxed">The {currency(reported.partialYearTotalPrintedInBudgetExhibit, 0)} total is appropriate for 2025: it equals seven startup months at approximately {currency(88_035.12)} per month. The problem is its inclusion, still labeled 2025, in the packet whose cover identifies fiscal 2026. The 2026 statements correctly use a full 12-month annual budget of {currency(reported.annualBudgetUsedInStatements, 0)}. Management should identify and distribute the board-adopted 12-month 2026 exhibit.</p>
				</div>

				<div class="rounded-2xl border border-rose-200 bg-rose-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-rose-700">Reserve study evidence</p>
					<h3 class="text-lg font-bold text-rose-950 mt-2">The referenced 2024 study and 2025 update are not in the supplied files</h3>
					<p class="text-sm text-rose-900/80 mt-3 leading-relaxed">The 2026 letter says an on-site study was performed in 2024 and an accounting update in 2025. The attached reserve pages are instead a preconstruction DRE budget worksheet dated April 24, 2023 and revised November 27, 2023. They calculate an annual contribution, but do not show accumulated cash, fully funded balance, percent funded, inflation and interest assumptions, or a 30-year cash-flow projection.</p>
				</div>

				<div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-emerald-700">2025 model treatment</p>
					<h3 class="text-lg font-bold text-emerald-950 mt-2">Seven months is the right scale for the startup year</h3>
					<p class="text-sm text-emerald-900/80 mt-3 leading-relaxed">The Association began generating operating activity around May 2025, and the financial packages model seven operating months from June through December. The {currency(616_245)} break-even budget and {currency(149_561.60)} of scheduled reserve funding therefore represent the intended partial-year period. They should not be stretched into a 12-month 2025 comparison.</p>
				</div>

				<div class="rounded-2xl border border-blue-200 bg-blue-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-blue-700">Special-assessment statement</p>
					<h3 class="text-lg font-bold text-blue-950 mt-2">The board said none was anticipated—not that one was impossible</h3>
					<p class="text-sm text-blue-900/80 mt-3 leading-relaxed">As of the November 2025 budget letter, the board did not anticipate a special assessment for major components or reserve adequacy and expressly said that statement was not a guarantee. Because the referenced reserve study was not supplied, this review cannot independently validate that conclusion. California's disclosure framework appears in Civil Code <a class="font-bold underline decoration-blue-300 underline-offset-2" href="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=5300." target="_blank" rel="noreferrer">§ 5300</a>, <a class="font-bold underline decoration-blue-300 underline-offset-2" href="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=5550." target="_blank" rel="noreferrer">§ 5550</a>, and <a class="font-bold underline decoration-blue-300 underline-offset-2" href="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=5570." target="_blank" rel="noreferrer">§ 5570</a>.</p>
				</div>
			</div>
		</section>

		<section aria-labelledby="accounting-exceptions">
			<div class="border-b border-slate-200 pb-3 mb-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">Accounting exceptions</p>
				<h2 id="accounting-exceptions" class="text-2xl font-bold text-slate-950">Three items could change how the reported position is understood</h2>
			</div>

			<div class="grid lg:grid-cols-3 gap-5">
				<div class="rounded-2xl border border-rose-200 bg-rose-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-rose-700">Suspense debit</p>
					<p class="text-3xl font-extrabold text-rose-800 mt-2">{currency(reported.suspenseDebit)}</p>
					<p class="text-sm text-rose-900/80 mt-3 leading-relaxed">A March CollectBureau bank debit was posted as a negative liability. If it belongs in operating expense, Q1 surplus would fall to {currency(derivedFinancials.adjustedQ1SurplusIfSuspenseIsExpense)}. Support and classification are required before relying on the reported margin.</p>
				</div>

				<div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-amber-700">Insurance check</p>
					<p class="text-3xl font-extrabold text-amber-800 mt-2">{currency(reported.unclearedPropertyInsuranceCheck)}</p>
					<p class="text-sm text-amber-900/80 mt-3 leading-relaxed">The December 1 property-insurance check remained uncleared on the March 31 reconciliation. Confirm coverage and payee status, then void or reissue as necessary while preventing a duplicate payment.</p>
				</div>

				<div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
					<p class="text-xs font-bold uppercase tracking-wider text-emerald-700">Insurance amortization</p>
					<p class="text-3xl font-extrabold text-emerald-800 mt-2">Reconciled</p>
					<p class="text-sm text-emerald-900/80 mt-3 leading-relaxed">The {currency(reported.insuranceAmortizationMonthly)} monthly amortization agrees to the {currency(reported.insurancePackageTotal)} package: {currency(reported.propertyInsurancePremium)} property plus {currency(reported.workersCompPremium)} workers’ compensation. The earlier “premium mismatch” conclusion was incorrect.</p>
				</div>
			</div>
		</section>

		<section aria-labelledby="revenue-quality">
			<div class="border-b border-slate-200 pb-3 mb-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">Revenue and occupancy</p>
				<h2 id="revenue-quality" class="text-2xl font-bold text-slate-950">Closings change payer mix and utility behavior</h2>
			</div>

			<div class="grid lg:grid-cols-3 gap-5">
				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-indigo-700">Closing progress</p>
					<div class="flex items-baseline gap-2 mt-2"><p class="text-3xl font-extrabold text-slate-950">{units.closedAtReviewDate}</p><p class="text-sm text-slate-500">of {units.total} · {percent(derivedFinancials.closingShareAtReviewDate)}</p></div>
					<p class="text-sm text-slate-600 mt-3 leading-relaxed">Only {derivedFinancials.remainingAtReviewDate} units remained as of July 20. Assessments on unsold units are assessment revenue, not a discretionary subsidy. The payer changes from developer to owner as units close.</p>
					<p class="text-xs text-slate-500 mt-3 leading-relaxed">The March closing log shows {derivedFinancials.remainingAtStatementDate} units not yet closed. The March ledger billed {currency(reported.marchDeveloperBilling)} and received {currency(reported.marchDeveloperPaymentInTransit)} in transit, with an opening credit explaining the difference.</p>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-cyan-700">Q1 water recovery</p>
					<p class="text-3xl font-extrabold text-slate-950 mt-2">{currency(derivedFinancials.waterReimbursementsMonthlyAverage)}</p>
					<p class="text-xs text-slate-500 mt-1">Average monthly reimbursement from {currency(reported.q1WaterReimbursements)} in Q1.</p>
					<div class="mt-5">
						<div class="flex justify-between text-xs font-semibold text-slate-600 mb-2"><span>Against monthly budget benchmark</span><span>{percent(derivedFinancials.waterRecoveryAgainstFullOccupancyBudget, 0)}</span></div>
						<div class="h-2.5 rounded-full bg-slate-100 overflow-hidden" role="img" aria-label={`${percent(derivedFinancials.waterRecoveryAgainstFullOccupancyBudget, 0)} of the monthly water reimbursement budget`}><div class="h-full rounded-full bg-cyan-500" style={`width: ${Math.min(derivedFinancials.waterRecoveryAgainstFullOccupancyBudget * 100, 100)}%`}></div></div>
					</div>
					<p class="text-xs text-slate-500 mt-4 leading-relaxed">Submeter revenue was {currency(Math.abs(-33_759.70))} below Q1 budget and explains nearly all of the total revenue shortfall.</p>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-xs font-bold uppercase tracking-wider text-cyan-700">Actual net utilities</p>
					<p class="text-3xl font-extrabold text-slate-950 mt-2">{currency(derivedFinancials.q1NetUtilitiesMonthlyAverage)}</p>
					<p class="text-xs text-slate-500 mt-1">Monthly average: {currency(derivedFinancials.grossUtilitiesMonthlyAverage)} gross less {currency(derivedFinancials.waterReimbursementsMonthlyAverage)} reimbursement.</p>
					<p class="text-sm text-slate-600 mt-4 leading-relaxed">The {currency(derivedFinancials.fullOccupancyIllustrativeNetUtilities)} amount obtained by subtracting the full-budget reimbursement from current gross cost is only an illustration. Usage and cost are likely to rise with occupancy, so it is not a current “true cost.”</p>
				</div>
			</div>
		</section>

		<section aria-labelledby="expense-watchlist">
			<div class="border-b border-slate-200 pb-3 mb-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">Property operations</p>
				<h2 id="expense-watchlist" class="text-2xl font-bold text-slate-950">Exceptions for invoice-level management</h2>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-x-auto">
				<table class="w-full min-w-[860px] text-sm">
					<thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500">
						<tr><th class="px-5 py-4 font-bold">Priority</th><th class="px-5 py-4 font-bold">Category</th><th class="px-5 py-4 font-bold">Period</th><th class="px-5 py-4 font-bold text-right">Amount</th><th class="px-5 py-4 font-bold">Management response</th></tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-slate-700">
						{watchItems.map(item => (
							<tr class="align-top">
								<td class="px-5 py-4"><span class={`inline-flex rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${priorityClass(item.priority)}`}>{item.priority}</span></td>
								<td class="px-5 py-4"><p class="font-bold text-slate-950">{item.category}</p><p class="text-xs text-slate-500 mt-1">{item.detail}</p></td>
								<td class="px-5 py-4 whitespace-nowrap">{item.period}</td>
								<td class="px-5 py-4 font-bold text-slate-950 text-right whitespace-nowrap">{currency(item.amount)}</td>
								<td class="px-5 py-4 text-xs leading-relaxed max-w-md">{item.action}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="rounded-3xl bg-slate-950 text-white p-6 md:p-8" aria-labelledby="management-plan">
			<div class="grid lg:grid-cols-[0.7fr_1.3fr] gap-8">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-300 mb-2">Board and management plan</p>
					<h2 id="management-plan" class="text-2xl md:text-3xl font-extrabold">Six priorities before the next financial review</h2>
					<p class="text-sm text-slate-300 leading-relaxed mt-4">These items address the highest-value accounting, cash, reserve, and property-management risks found in the source packages.</p>
				</div>
				<ol class="grid sm:grid-cols-2 gap-4 text-sm">
					<li class="rounded-2xl border border-slate-700 bg-slate-900 p-4"><span class="text-blue-300 font-extrabold">01 · Reporting</span><p class="text-slate-300 mt-2">Approve and release April–June statements with written explanations for material variances and late reporting.</p></li>
					<li class="rounded-2xl border border-slate-700 bg-slate-900 p-4"><span class="text-blue-300 font-extrabold">02 · Cash</span><p class="text-slate-300 mt-2">Adopt a documented repayment plan for the {currency(reported.reserveDueFromOperating)} interfund balance and preserve an operating-cash floor.</p></li>
					<li class="rounded-2xl border border-slate-700 bg-slate-900 p-4"><span class="text-blue-300 font-extrabold">03 · Exceptions</span><p class="text-slate-300 mt-2">Resolve the CollectBureau suspense debit and the stale insurance check; retain invoice and bank support.</p></li>
					<li class="rounded-2xl border border-slate-700 bg-slate-900 p-4"><span class="text-blue-300 font-extrabold">04 · Budget</span><p class="text-slate-300 mt-2">Identify the adopted 2026 budget and reissue a 12-month pro forma with the correct year and annual totals.</p></li>
					<li class="rounded-2xl border border-slate-700 bg-slate-900 p-4"><span class="text-blue-300 font-extrabold">05 · Reserves</span><p class="text-slate-300 mt-2">Obtain the stated 2024 on-site study and 2025 update, including percent funded and 30-year cash flow—or commission the current study if they cannot be produced.</p></li>
					<li class="rounded-2xl border border-slate-700 bg-slate-900 p-4"><span class="text-blue-300 font-extrabold">06 · Operations</span><p class="text-slate-300 mt-2">Maintain system-level exception logs for elevators, plumbing, access control, and janitorial work, including warranty and developer recovery.</p></li>
				</ol>
			</div>
		</section>

		<section class="grid lg:grid-cols-[1fr_0.8fr] gap-6" aria-labelledby="sources-method">
			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h2 id="sources-method" class="text-xl font-bold text-slate-950 mb-3">Sources and method</h2>
				<p class="text-sm text-slate-600 leading-relaxed mb-4">This review extracted all 574 pages supplied, re-footed key statements, traced material balances to ledgers and reconciliations, and visually checked the controlling pages. Source files reviewed:</p>
				<ul class="list-disc pl-5 text-sm text-slate-700 space-y-1.5 mb-5">
					{sourceDocuments.map(source => <li>{source}</li>)}
				</ul>
				<p class="text-xs text-slate-500 leading-relaxed"><strong>Key page checks:</strong> March 2026 balance sheet and income statement; reserve due-to schedule, operating and reserve bank reconciliations, and prepaid-insurance schedule; December 2025 balance sheet and income statement; 2026 budget letter and Exhibits A–E; DRE reserve worksheet and review.</p>
				<p class="text-xs text-slate-500 leading-relaxed mt-3"><strong>Scope limitation:</strong> This is an analytical review, not an audit, reserve study, legal opinion, or attestation of board approval. Private source documents are intentionally excluded from the published repository.</p>
			</div>

			<div class="rounded-2xl border border-blue-200 bg-blue-50 p-6">
				<h2 class="text-xl font-bold text-blue-950 mb-3">Records still needed</h2>
				<ul class="list-disc pl-5 text-sm text-blue-900/80 space-y-2 mb-5">
					<li>Approved April–June 2026 financial packages</li>
					<li>Adopted 12-month 2026 pro forma and board minutes</li>
					<li>2024 on-site reserve study and 2025 update</li>
					<li>Year-end review or audit and tax return</li>
					<li>Current delinquency aging and reserve repayment plan</li>
				</ul>
				<a href="/cb-archive/#records-request" class="inline-flex items-center rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-800 transition">How to request records →</a>
			</div>
		</section>
	</div>
</BaseLayout>
