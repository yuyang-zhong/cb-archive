<script>
	import { bridge2027, model2027Defaults, runModel2027 } from '../../data/financialOverview';

	const root = document.querySelector<HTMLElement>('[data-model]');
	const form = root?.querySelector<HTMLFormElement>('[data-model-form]');
	const averageMonthlyAssessment = 817_387 / 148 / 12;
	const meterMax = 0.25;

	const compact = (value: number) => {
		const sign = value < 0 ? '−' : '';
		const abs = Math.abs(value);
		return abs >= 1000 ? `${sign}$${(abs / 1000).toFixed(1)}k` : `${sign}$${Math.round(abs)}`;
	};
	const signed = (value: number) => (value > 0 ? '+' : '') + compact(value);
	const signedPercent = (value: number) =>
		(value > 0 ? '+' : value < 0 ? '−' : '') + `${Math.abs(value * 100).toFixed(1)}%`;

	function render() {
		if (!root || !form) return;
		const data = new FormData(form);
		const input = {
			...model2027Defaults,
			insuranceIncrease: Number(data.get('insuranceIncrease')) / 100,
			reserveShare: Number(data.get('reserveShare')) / 100,
			submeterRecovery: Number(data.get('submeterRecovery')) / 100,
			solarRestored: data.has('solarRestored'),
			restoreDeferredServices: data.has('restoreDeferredServices'),
			janitorial: data.has('janitorialHigh') ? 69_797 : 40_200,
			electricitySpikePersists: data.has('electricitySpikePersists'),
		};
		const result = runModel2027(input);
		const bridge = bridge2027(input);

		root.querySelector('[data-hero]')!.textContent = signedPercent(result.increase);
		root.querySelector('[data-hero-detail]')!.textContent =
			`≈${signed(result.increase * averageMonthlyAssessment)} per month for the average unit (today $${averageMonthlyAssessment.toFixed(2)})`;
		root.querySelector<HTMLElement>('[data-meter]')!.style.width =
			`${Math.max(0, Math.min(result.increase / meterMax, 1)) * 100}%`;
		root.querySelector('[data-out="insuranceIncrease"]')!.textContent = `+${Math.round(input.insuranceIncrease * 100)}%`;
		root.querySelector('[data-out="reserveShare"]')!.textContent = `${Math.round(input.reserveShare * 100)}% of today`;
		root.querySelector('[data-out="submeterRecovery"]')!.textContent = `${Math.round(input.submeterRecovery * 100)}%`;

		const list = root.querySelector('[data-bridge]')!;
		const row = (label: string, value: string, bold = false) => {
			const item = document.createElement('li');
			item.className = `flex justify-between py-1.5${bold ? ' font-bold' : ''}`;
			const name = document.createElement('span');
			name.textContent = label;
			const amount = document.createElement('span');
			amount.textContent = value;
			item.append(name, amount);
			return item;
		};
		list.replaceChildren(
			row('2026 pace (Jan–Sep annualized)', signed(bridge.start)),
			...bridge.items.map(item => row(item.label, signed(item.value))),
			row('2027 at current assessments', signed(bridge.end), true),
		);
	}

	form?.addEventListener('input', render);
	form?.addEventListener('submit', event => event.preventDefault());
	render();
</script>
