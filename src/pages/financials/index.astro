---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	bridge2027,
	derivedFinancials,
	financialOverview,
	insuranceCashTest,
	model2027Defaults,
	model2027Scenarios,
	runModel2027,
} from '../../data/financialOverview';

const {
	reported,
	asOf,
	reviewedOn,
	statementsPreparedOn,
	deadlines,
	receivableGaps,
	spendingIncreases,
	unpaidBudgetLines,
	codingFixes,
	garageCostCenter,
	reserves,
	openItems,
	recordsNeeded,
	sourceDocuments,
	submeterHistory,
	submeterGap,
	subsequentEvents,
	midBlockAgreement,
} = financialOverview;

const currency = (value: number, digits = 0) =>
	new Intl.NumberFormat('en-US', {
		style: 'currency',
		currency: 'USD',
		minimumFractionDigits: digits,
		maximumFractionDigits: digits,
	}).format(value);

const percent = (value: number, digits = 1) =>
	new Intl.NumberFormat('en-US', {
		style: 'percent',
		minimumFractionDigits: digits,
		maximumFractionDigits: digits,
	}).format(value);

// $40.6k / −$17.6k style for tiles and labels.
const compact = (value: number) => {
	const sign = value < 0 ? '−' : '';
	const abs = Math.abs(value);
	return abs >= 1000 ? `${sign}$${(abs / 1000).toFixed(1)}k` : `${sign}$${Math.round(abs)}`;
};
const signed = (value: number) => (value > 0 ? '+' : '') + compact(value);
const signedPercent = (value: number) => (value > 0 ? '+' : value < 0 ? '−' : '') + percent(Math.abs(value));

const statusClass: Record<string, string> = {
	Missing: 'bg-rose-50 text-rose-800 border-rose-200',
	'Not done': 'bg-rose-50 text-rose-800 border-rose-200',
	Verify: 'bg-amber-50 text-amber-900 border-amber-200',
	Ask: 'bg-amber-50 text-amber-900 border-amber-200',
	Open: 'bg-amber-50 text-amber-900 border-amber-200',
	Unscheduled: 'bg-slate-100 text-slate-700 border-slate-200',
	'On track': 'bg-emerald-50 text-emerald-800 border-emerald-200',
	Started: 'bg-emerald-50 text-emerald-800 border-emerald-200',
};
const statusIcon: Record<string, string> = {
	Missing: '✕', 'Not done': '✕', Verify: '!', Ask: '?', Open: '!', Unscheduled: '…', 'On track': '✓', Started: '✓',
};

const ink = { primary: '#0b0b0b', secondary: '#52514e', muted: '#898781', grid: '#e1e0d9', axis: '#c3c2b7' };
const positiveHue = '#2a78d6';
const negativeHue = '#e34948';
const contextHue = '#a8a69f';

// Column path with a 4px rounded data end and a square baseline end.
const columnPath = (x: number, width: number, from: number, to: number) => {
	const radius = Math.min(4, Math.abs(to - from), width / 2);
	if (to < from) {
		return `M${x},${from}V${to + radius}Q${x},${to} ${x + radius},${to}H${x + width - radius}Q${x + width},${to} ${x + width},${to + radius}V${from}Z`;
	}
	return `M${x},${from}V${to - radius}Q${x},${to} ${x + radius},${to}H${x + width - radius}Q${x + width},${to} ${x + width},${to - radius}V${from}Z`;
};

// Monthly result chart (diverging around zero).
const results = derivedFinancials.monthlyResults;
const resultChart = { width: 360, height: 176, top: 18, bottom: 22, left: 34, right: 4, max: 20_000 };
const resultPlotHeight = resultChart.height - resultChart.top - resultChart.bottom;
const resultY = (value: number) =>
	resultChart.top + resultPlotHeight / 2 - (value / resultChart.max) * (resultPlotHeight / 2);
const resultBand = (resultChart.width - resultChart.left - resultChart.right) / results.length;
const resultBarWidth = Math.min(24, resultBand * 0.62);
const labeledMonths = new Set(['Apr', 'Sep']);

// Water cost vs. MeterNet remittance (one dollar axis).
const waterChart = { width: 640, height: 220, top: 16, bottom: 26, left: 40, right: 132, max: 18_000 };
const waterPlotHeight = waterChart.height - waterChart.top - waterChart.bottom;
const waterStep = (waterChart.width - waterChart.left - waterChart.right) / (submeterHistory.length - 1);
const waterX = (index: number) => waterChart.left + index * waterStep;
const waterY = (value: number) => waterChart.top + waterPlotHeight - (value / waterChart.max) * waterPlotHeight;
const linePath = (key: 'water' | 'remitted') =>
	submeterHistory.map((point, index) => `${index ? 'L' : 'M'}${waterX(index).toFixed(1)},${waterY(point[key]).toFixed(1)}`).join('');
const lastWater = submeterHistory[submeterHistory.length - 1];

const overruns = spendingIncreases
	.map(row => ({ ...row, over: row.current - row.budget }))
	.sort((a, b) => b.over - a.over);
const maxOverrun = Math.max(...overruns.map(row => row.over));
const totalOverrun = overruns.reduce((total, row) => total + row.over, 0);

const tiers = [
	{ key: 'missing', title: 'Not received' },
	{ key: 'recover', title: 'Verify, then recover' },
	{ key: 'unrealized', title: 'Budgeted benefit never received' },
	{ key: 'question', title: 'Ask management' },
];

const cashRows = insuranceCashTest.map(row => ({
	...row,
	label: `${row.submeterResumes ? 'MeterNet resumes' : 'MeterNet still missing'} · ${row.voided ? 'check voided' : 'check not voided'}`,
}));

const baseline = runModel2027(model2027Defaults);
const baselineBridge = bridge2027(model2027Defaults);
const averageMonthlyAssessment = reported.memberAssessmentsBudget / financialOverview.units.total / 12;
const meterMax = 0.25;
---

<BaseLayout
	title="Financial Dashboard"
	description={`China Basin HOA financial dashboard: statements through ${asOf}, insurance cash test, receivables, spending, coding fixes, reserves, and a 2027 margin model.`}
>
	<header class="mb-8 max-w-4xl">
		<div class="flex flex-wrap gap-2 mb-4 text-xs font-bold uppercase tracking-wider">
			<span class="rounded-full bg-slate-900 px-3 py-1 text-white">Through {asOf}</span>
			<span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-700">Prepared {statementsPreparedOn.replace(', 2026', '')} · 26-day lag</span>
			<span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-700">Reviewed {reviewedOn.replace(', 2026', '')}</span>
			<span class="rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-amber-800">Approval not verified · not an audit</span>
		</div>
		<h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-950 mb-4">Financial dashboard</h1>
		<ul class="space-y-2 text-slate-700 leading-relaxed">
			<li><strong class="text-slate-950">September lost {compact(reported.monthly2026[8].expenses - reported.monthly2026[8].revenue)}</strong>, mainly because the MeterNet water remittance never arrived.</li>
			<li><strong class="text-slate-950">The Nov 27 insurance renewal is affordable only if the duplicate {compact(reported.insurance.duplicateCheck)} check is voided first.</strong></li>
			<li><strong class="text-slate-950">2027 needs about {signedPercent(baseline.increase)}</strong> at today’s costs; restoring the solar credit and trimming reserves 10% brings it near {signedPercent(model2027Scenarios[2].result.increase)}.</li>
		</ul>
	</header>

	<div class="space-y-10">
		<section aria-labelledby="dates">
			<h2 id="dates" class="text-xs font-bold uppercase tracking-[0.18em] text-rose-700 mb-3">Board calendar</h2>
			<ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
				{deadlines.map(deadline => (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<p class="text-sm font-extrabold text-slate-950">{deadline.date}</p>
						<p class="text-xs text-slate-600 mt-1 leading-relaxed">{deadline.item}</p>
					</li>
				))}
			</ol>
		</section>

		<section aria-label="Key figures" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
			<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
				<p class="text-sm text-slate-500">YTD net income</p>
				<p class="text-3xl font-bold text-slate-950 mt-1">{compact(reported.ytdSurplus)}</p>
				<p class="text-xs text-slate-600 mt-2">September {compact(reported.monthly2026[8].revenue - reported.monthly2026[8].expenses)} · August YTD was {compact(financialOverview.previousReview.ytdSurplus)}</p>
			</div>
			<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
				<p class="text-sm text-slate-500">Unrestricted operating cash</p>
				<p class="text-3xl font-bold text-slate-950 mt-1">{compact(reported.unrestrictedOperatingCash)}</p>
				<p class="text-xs text-slate-600 mt-2">{compact(derivedFinancials.unrestrictedCashIfVoided)} if the duplicate check is voided</p>
			</div>
			<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
				<p class="text-sm text-slate-500">Reserve fund</p>
				<p class="text-3xl font-bold text-slate-950 mt-1">{compact(reported.reserveFundBalance)}</p>
				<p class="text-xs text-slate-600 mt-2">{percent(derivedFinancials.reserveShareOfBudget)} of the budget is reserve funding</p>
			</div>
			<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
				<p class="text-sm text-slate-500">Still owed to reserves by operating</p>
				<p class="text-3xl font-bold text-slate-950 mt-1">{compact(reported.reserveDueFromOperating)}</p>
				<p class="text-xs text-slate-600 mt-2">Unfunded Nov–Dec 2025; two installments left</p>
			</div>
		</section>

		<section aria-labelledby="monthly" class="rounded-2xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm">
			<div class="grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:items-center">
				<div>
					<h2 id="monthly" class="text-xl font-bold text-slate-950">Monthly net income, 2026</h2>
					<p class="text-sm text-slate-600 mt-2 leading-relaxed">September is the worst month of the year. With a typical MeterNet remittance it would have been about {compact(derivedFinancials.septemberWithoutMissingRemittance)}; refuse, fire monitoring, and the first reserve-study invoice ({currency(reserves.studyPaid)}) did the rest.</p>
				</div>
				<figure>
					<svg viewBox={`0 0 ${resultChart.width} ${resultChart.height}`} class="w-full h-auto" role="img" aria-label="Monthly net income January to September 2026">
						{[-20_000, -10_000, 0, 10_000, 20_000].map(tick => (
							<g>
								<line x1={resultChart.left} x2={resultChart.width - resultChart.right} y1={resultY(tick)} y2={resultY(tick)} stroke={tick === 0 ? ink.axis : ink.grid} stroke-width="1" />
								<text x={resultChart.left - 6} y={resultY(tick) + 3} text-anchor="end" font-size="10" fill={ink.muted} style="font-variant-numeric: tabular-nums">{tick === 0 ? '0' : `${tick / 1000}K`}</text>
							</g>
						))}
						{results.map((month, index) => {
							const x = resultChart.left + index * resultBand + (resultBand - resultBarWidth) / 2;
							const top = resultY(month.result);
							const zero = resultY(0);
							return (
								<g>
									<path d={columnPath(x, resultBarWidth, zero, top)} fill={month.result >= 0 ? positiveHue : negativeHue}>
										<title>{`${month.month} 2026: ${currency(month.result)} (revenue ${currency(month.revenue)}, expenses ${currency(month.expenses)})`}</title>
									</path>
									<text x={x + resultBarWidth / 2} y={resultChart.height - 6} text-anchor="middle" font-size="10" fill={ink.muted}>{month.month}</text>
									{labeledMonths.has(month.month) && (
										<text x={x + resultBarWidth / 2} y={month.result >= 0 ? top - 4 : top + 11} text-anchor="middle" font-size="10" font-weight="600" fill={ink.primary}>{signed(month.result)}</text>
									)}
								</g>
							);
						})}
					</svg>
					<figcaption class="sr-only">Positive months in blue, negative in red.</figcaption>
				</figure>
			</div>
			<details class="mt-4 text-sm">
				<summary class="cursor-pointer font-semibold text-blue-800">Monthly table</summary>
				<div class="overflow-x-auto mt-3">
					<table class="w-full min-w-[480px] text-sm" style="font-variant-numeric: tabular-nums">
						<thead class="text-left text-xs uppercase tracking-wider text-slate-500"><tr><th class="py-2">Month</th><th class="py-2 text-right">Revenue</th><th class="py-2 text-right">Expenses</th><th class="py-2 text-right">Net</th></tr></thead>
						<tbody class="divide-y divide-slate-100">
							{results.map(month => (
								<tr><td class="py-1.5">{month.month}</td><td class="py-1.5 text-right">{currency(month.revenue, 2)}</td><td class="py-1.5 text-right">{currency(month.expenses, 2)}</td><td class="py-1.5 text-right font-semibold">{currency(month.result, 2)}</td></tr>
							))}
							<tr class="font-bold"><td class="py-1.5">Jan–Sep</td><td class="py-1.5 text-right">{currency(reported.ytdRevenue, 2)}</td><td class="py-1.5 text-right">{currency(reported.ytdExpenses, 2)}</td><td class="py-1.5 text-right">{currency(reported.ytdSurplus, 2)}</td></tr>
						</tbody>
					</table>
				</div>
				<p class="text-xs text-slate-500 mt-2">Expenses include {currency(reported.monthlyReserveAllocation, 2)} of reserve funding each month. YTD budget was break-even at {currency(reported.ytdBudget, 2)}.</p>
			</details>
		</section>

		<section aria-labelledby="cash-test" class="rounded-2xl border border-rose-200 bg-rose-50/40 p-5 md:p-6">
			<p class="text-xs font-bold uppercase tracking-[0.18em] text-rose-700 mb-1">November cash test</p>
			<h2 id="cash-test" class="text-2xl font-bold text-slate-950">Void the duplicate check before paying the renewal</h2>
			<p class="text-sm text-slate-700 mt-2 leading-relaxed max-w-3xl">The Association understands the developer paid the 2025–26 premium. The Association’s own {currency(reported.insurance.duplicateCheck, 2)} check to the broker, dated {reported.insurance.duplicateCheckDated}, has not cleared in {reported.insurance.duplicateCheckAgeDays} days. Voiding it was already requested; it was still outstanding at September 30. Confirm with the broker, place a stop-payment, then void.</p>
			<div class="overflow-x-auto mt-4">
				<table class="w-full min-w-[620px] text-sm bg-white rounded-xl border border-slate-200" style="font-variant-numeric: tabular-nums">
					<caption class="sr-only">Unrestricted operating cash at the end of November after paying Otis and insurance</caption>
					<thead class="text-left text-xs uppercase tracking-wider text-slate-500 bg-slate-50">
						<tr><th class="px-4 py-3">Unrestricted cash after renewals</th><th class="px-4 py-3 text-right">Same premium</th><th class="px-4 py-3 text-right">Premium +10%</th><th class="px-4 py-3 text-right">Premium +25%</th></tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						{cashRows.map(row => (
							<tr>
								<td class="px-4 py-3 text-slate-700">{row.label}</td>
								{[row.flat, row.plus10, row.plus25].map(value => (
									<td class="px-4 py-3 text-right">
										<span class="font-semibold text-slate-950">{compact(value)}</span>
										{value < 0 && <span class="ml-2 inline-flex rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 text-[10px] font-bold uppercase text-rose-800">✕ Short</span>}
									</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<details class="mt-3 text-xs text-slate-600">
				<summary class="cursor-pointer font-semibold text-blue-800">Assumptions and caveats</summary>
				<ul class="list-disc pl-5 mt-2 space-y-1 leading-relaxed">
					<li>Starts from {currency(reported.unrestrictedOperatingCash, 2)} at Sep 30 (ledger cash less the amount owed to reserves). October–November repeat September’s cash change; “resumes” adds a typical {currency(11_600)} monthly remittance plus the missing September one.</li>
					<li>Pays the Otis renewal ({currency(reported.elevatorContract.annual, 2)}) and the insurance package ({currency(reported.insurance.package, 2)} last year) in full.</li>
					<li>“Voided” rows assume nothing is owed back to the developer for the premium. If reimbursement is owed, use the “not voided” rows.</li>
					<li>Janitorial labor has not been paid since December 2025. If those invoices exist but were never billed, up to ≈$30k would reduce every cell.</li>
					<li>Excludes reserve cash and the October developer payment, both restricted. Prepaid assessments ({currency(reported.prepaidAssessments)}) and deposits ({currency(reported.refundableDeposits)}) are still owed to owners. Premium installments are the fallback; a temporary reserve transfer (Civ. Code §5515) is a last resort.</li>
				</ul>
			</details>
		</section>

		<section aria-labelledby="q-receivables">
			<div class="border-b border-slate-200 pb-3 mb-5">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 mb-1">1 · Receivables</p>
				<h2 id="q-receivables" class="text-2xl font-bold text-slate-950">Booked receivables are clean; the gaps are money never billed or received</h2>
			</div>
			<div class="grid gap-4 sm:grid-cols-3 mb-5">
				<div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-sm text-slate-500">Owner balances</p><p class="text-2xl font-bold text-slate-950">{currency(reported.receivables.owners)}</p><p class="text-xs text-slate-600 mt-1">{currency(reported.receivables.ownersOver30, 2)} over 30 days ({reported.receivables.ownerAccountsOver30} accounts)</p></div>
				<div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-sm text-slate-500">“Other” receivable</p><p class="text-2xl font-bold text-slate-950">{currency(reported.receivables.other)}</p><p class="text-xs text-slate-600 mt-1">Duplicate billing; write off</p></div>
				<div class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-sm text-slate-500">Developer</p><p class="text-2xl font-bold text-slate-950">{currency(reported.receivables.developer)}</p><p class="text-xs text-slate-600 mt-1">All units sold; billing has ended</p></div>
			</div>

			<figure class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
				<figcaption class="mb-3">
					<p class="font-bold text-slate-950">Water bill vs. MeterNet remittances</p>
					<p class="text-xs text-slate-600">Since June 2025 MeterNet returned {percent(derivedFinancials.submeterRemittedTotal / derivedFinancials.submeterWaterTotal, 0)} of water cost; May–Aug 2026 ran near full recovery.</p>
				</figcaption>
				<div class="flex flex-wrap gap-4 text-xs text-slate-600 mb-2">
					<span class="inline-flex items-center gap-2"><span class="inline-block h-0.5 w-5 rounded" style={`background:${contextHue}`}></span>Water cost</span>
					<span class="inline-flex items-center gap-2"><span class="inline-block h-0.5 w-5 rounded" style={`background:${positiveHue}`}></span>MeterNet remittance</span>
				</div>
				<div class="overflow-x-auto">
					<svg viewBox={`0 0 ${waterChart.width} ${waterChart.height}`} class="w-full min-w-[560px] max-w-[820px] h-auto" role="img" aria-label="Monthly water cost and MeterNet remittances, June 2025 to September 2026">
						{[0, 5_000, 10_000, 15_000].map(tick => (
							<g>
								<line x1={waterChart.left} x2={waterChart.width - waterChart.right} y1={waterY(tick)} y2={waterY(tick)} stroke={tick === 0 ? ink.axis : ink.grid} stroke-width="1" />
								<text x={waterChart.left - 6} y={waterY(tick) + 3} text-anchor="end" font-size="10" fill={ink.muted} style="font-variant-numeric: tabular-nums">{tick === 0 ? '0' : `${tick / 1000}K`}</text>
							</g>
						))}
						{submeterHistory.map((point, index) => (index % 3 === 0 || index === submeterHistory.length - 1) && (
							<text x={waterX(index)} y={waterChart.height - 8} text-anchor="middle" font-size="10" fill={ink.muted}>{point.month}</text>
						))}
						<path d={linePath('water')} fill="none" stroke={contextHue} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
						<path d={linePath('remitted')} fill="none" stroke={positiveHue} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
						<circle cx={waterX(submeterHistory.length - 1)} cy={waterY(lastWater.water)} r="4" fill={contextHue} stroke="#fcfcfb" stroke-width="2" />
						<circle cx={waterX(submeterHistory.length - 1)} cy={waterY(lastWater.remitted)} r="4" fill={positiveHue} stroke="#fcfcfb" stroke-width="2" />
						<text x={waterX(submeterHistory.length - 1) + 10} y={waterY(lastWater.water) + 4} font-size="10" fill={ink.secondary}>Water {compact(lastWater.water)}</text>
						<text x={waterX(submeterHistory.length - 1) + 10} y={waterY(lastWater.remitted) - 4} font-size="10" font-weight="600" fill={ink.primary}>Sep: $0 received</text>
						<text x={waterX(2.6)} y={waterY(12_200)} text-anchor="middle" font-size="10" fill={ink.secondary}>No remittances Jun–Nov 2025</text>
						{submeterHistory.map((point, index) => (
							<rect x={waterX(index) - waterStep / 2} y={waterChart.top} width={waterStep} height={waterPlotHeight} fill="transparent">
								<title>{`${point.month}: water ${currency(point.water, 2)}, remitted ${currency(point.remitted, 2)}`}</title>
							</rect>
						))}
					</svg>
				</div>
				<details class="mt-3 text-sm">
					<summary class="cursor-pointer font-semibold text-blue-800">Monthly table</summary>
					<div class="overflow-x-auto mt-2">
						<table class="w-full min-w-[420px] text-sm" style="font-variant-numeric: tabular-nums">
							<thead class="text-left text-xs uppercase tracking-wider text-slate-500"><tr><th class="py-2">Month</th><th class="py-2 text-right">Water cost</th><th class="py-2 text-right">Remitted</th></tr></thead>
							<tbody class="divide-y divide-slate-100">
								{submeterHistory.map(point => <tr><td class="py-1">{point.month}</td><td class="py-1 text-right">{currency(point.water, 2)}</td><td class="py-1 text-right">{currency(point.remitted, 2)}</td></tr>)}
								<tr class="font-bold"><td class="py-1">Total</td><td class="py-1 text-right">{currency(derivedFinancials.submeterWaterTotal, 2)}</td><td class="py-1 text-right">{currency(derivedFinancials.submeterRemittedTotal, 2)}</td></tr>
							</tbody>
						</table>
					</div>
					<p class="text-xs text-slate-500 mt-2">At the budget’s {percent(submeterGap.budgetRecoveryRatio)} recovery ratio, the cumulative shortfall is {currency(submeterGap.total)}: {currency(submeterGap.startup)} from start-up months and {currency(submeterGap.september)} for September. Aggregate recovery does not show whether individual meters misread; that needs MeterNet’s read history.</p>
				</details>
			</figure>

			<div class="grid gap-4 md:grid-cols-2 mt-5">
				{tiers.map(tier => (
					<div class="rounded-xl border border-slate-200 bg-white p-4">
						<p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">{tier.title}</p>
						<ul class="space-y-3">
